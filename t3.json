{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "xcodegen generate",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Build",
      "command": "swift build",
      "icon": "build"
    },
    {
      "name": "Test",
      "command": "swift test",
      "icon": "test"
    },
    {
      "name": "Build app bundle",
      "command": "bash scripts/build-app.sh",
      "icon": "build"
    },
    {
      "name": "Clean on settle",
      "command": "rm -rf .build",
      "icon": "configure",
      "runOnSettle": true
    }
  ]
}
